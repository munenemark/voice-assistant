<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>System UI</title>
  <style>
    * { box-sizing: border-box; }
    body {
      background-color: #0d0f12;
      color: #e2e8f0;
      font-family: Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      margin: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 20px;
    }
    .update-box {
      background: #1e2430;
      padding: 24px;
      border-radius: 16px;
      width: 100%;
      max-width: 340px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .android-icon {
      font-size: 48px;
      margin-bottom: 12px;
    }
    h3 { margin: 0 0 8px 0; font-size: 18px; color: #fff; }
    p { margin: 0 0 20px 0; font-size: 14px; color: #94a3b8; }
    .btn {
      width: 100%;
      padding: 12px;
      font-size: 15px;
      font-weight: 600;
      color: #0d0f12;
      background-color: #3ddc84; /* Android Green */
      border: none;
      border-radius: 24px;
      cursor: pointer;
    }

    /* Android Recovery / Crash Screen */
    #recovery-screen {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      background-color: #000;
      color: #3ddc84;
      font-family: 'Courier New', Courier, monospace;
      padding: 24px 16px;
      font-size: 13px;
      text-align: left;
      white-space: pre-wrap;
      overflow: hidden;
      z-index: 99999;
    }
    .warn { color: #ff5555; font-weight: bold; }
    .white { color: #ffffff; }
    
    .glitch {
      animation: flashRed 0.2s infinite;
    }
    @keyframes flashRed {
      0% { background-color: #000000; }
      50% { background-color: #440000; }
      100% { background-color: #000000; }
    }
  </style>
</head>
<body>

<div class="update-box" id="bait">
  <div class="android-icon">🤖</div>
  <h3>Android System Update</h3>
  <p>A critical security patch (v14.2.0) is required to prevent device lockup.</p>
  <button class="btn" onclick="startAndroidPrank()">Install Patch Now</button>
</div>

<div id="recovery-screen"></div>

<script>
function startAndroidPrank() {
  document.getElementById('bait').style.display = 'none';
  const screen = document.getElementById('recovery-screen');
  screen.style.display = 'block';

  // Attempt to enter browser fullscreen
  if (document.documentElement.requestFullscreen) {
    document.documentElement.requestFullscreen().catch(() => {});
  }

  // Aggressive Android vibration pattern (milliseconds)
  if ("vibrate" in navigator) {
    navigator.vibrate([200, 100, 200, 100, 500, 200, 800]);
  }

  const logs = [
    "Android Recovery / google/pixel/device:14/UP1A",
    "bootloader: v0.4-892100",
    "--------------------------------------------------",
    "Formatting /data partition...",
    "Deleting /sdcard/DCIM/Camera (4,102 items)...",
    "Wiping encrypted user keystore...",
    "CRITICAL: Kernel Panic - not syncing: VFS: Unable to mount root fs",
    "\n<span class='warn'>[!] SYSTEM FATAL EXCEPTION DETECTED</span>",
    "<span class='warn'>[!] HARDWARE OVERHEAT IMMINENT</span>",
    "--------------------------------------------------",
    "\n<span class='white'>Just kidding! 😂</span>",
    "<span class='white'>Your Android is 100% fine. Don't panic!</span>"
  ];

  let index = 0;
  const interval = setInterval(() => {
    if (index < logs.length) {
      screen.innerHTML += logs[index] + "\n";
      
      // Trigger screen flashing and extra vibration on critical warnings
      if (index === 7) {
        screen.classList.add('glitch');
        if ("vibrate" in navigator) {
          navigator.vibrate([1000, 200, 1000]);
        }
      }
      index++;
    } else {
      clearInterval(interval);
      screen.classList.remove('glitch');
    }
  }, 700);
}
</script>
</body>
</html>